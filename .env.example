# Copy to .env for docker compose. Never commit real secrets.
POSTGRES_DB=drama
POSTGRES_USER=drama
POSTGRES_PASSWORD=change-me-local-db-password

# At least 32 random bytes; generate with: openssl rand -hex 32
JWT_SECRET=change-me-use-a-random-32-byte-secret

# URL users open in the browser. Keep the /api proxy on the same origin.
PUBLIC_BASE_URL=http://localhost:8088

# Development payment mode: no real WeChat merchant is called.
WXPAY_MOCK=1
NODE_ENV=development

# Optional text/image/video provider. The upstream API contract is documented
# in README.md; the project does not ship provider credentials.
LIMENG_BASE_URL=http://localhost:8081/v1
LIMENG_API_KEY=replace-with-your-provider-key
LIMENG_TEXT_MODEL=qwen3.8-27b-local

# VIDEO_RESOLUTION=720P
# RESEND_API_KEY=replace-with-resend-key
# RESEND_FROM=Drama Platform <noreply@example.com>
