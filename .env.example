# ── Runtime ────────────────────────────────────────────────────────────────
APP_NAME=drama-platform
NODE_ENV=development
PORT=8080
BIND_ADDR=0.0.0.0
PUBLIC_BASE_URL=http://localhost:8080
STORAGE_DIR=./storage

# ── PostgreSQL ─────────────────────────────────────────────────────────────
# Used when running the binary directly on the host.
DATABASE_URL=postgres://drama:change-me@127.0.0.1:5432/drama?sslmode=disable
# Optional owner role used only by `drama-server migrate` and `grant-runtime`.
DATABASE_URL_OWNER=postgres://postgres:change-me@127.0.0.1:5432/drama?sslmode=disable

# Docker Compose database credentials (also used to build DATABASE_URL there).
POSTGRES_DB=drama
POSTGRES_USER=drama
POSTGRES_PASSWORD=change-me

# ── Auth ───────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET=replace-with-a-long-random-string

# ── Generation upstream (OpenAI-compatible) ────────────────────────────────
LIMENG_BASE_URL=https://api.example.com/v1
LIMENG_API_KEY=replace-with-your-generation-api-key
LIMENG_TEXT_MODEL=replace-with-your-text-model
VIDEO_RESOLUTION=720p

# ── Media tools (not bundled; install separately) ─────────────────────────
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
ASSEMBLY_FFMPEG_PATH=ffmpeg
ASSEMBLY_FFPROBE_PATH=ffprobe

# ── WeChat Pay (leave empty for local development) ────────────────────────
WXPAY_APPID=
WXPAY_MCHID=
WXPAY_SERIAL=
WXPAY_APIV3_KEY=
WXPAY_KEY_PATH=
WXPAY_PLATFORM_SERIAL=
WXPAY_PLATFORM_PUBKEY_PATH=
WXPAY_NOTIFY_URL=
WXPAY_H5_ENABLED=0
WXPAY_MOCK=1

# ── Transactional email (Resend preferred, SMTP fallback) ─────────────────
RESEND_API_KEY=
RESEND_FROM=no-reply@example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@example.com
SMTP_TLS=1

# ── Tests (optional) ───────────────────────────────────────────────────────
# TEST_DATABASE_URL=postgres://drama:change-me@127.0.0.1:5432/drama_test?sslmode=disable
